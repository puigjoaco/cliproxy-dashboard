[Unit]
Description=Shared Codex health and local router notifications
After=personal-codex-router-dashboard.service

[Service]
Type=oneshot
User=root
Group=cliproxyapi
ExecStart=/usr/bin/python3 /opt/personal-codex-router/router-ops.py
TimeoutStartSec=30
UMask=0027
# Codex's control socket is a symlink into /tmp/codex-daemon-1000.
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/personal-codex-router-ops
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
